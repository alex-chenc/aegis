# .env - 环境变量配置文件（请勿提交到 Git）

# 数据库
DB_PASSWORD=a_strong_db_password_here
DB_PORT=5432

# Redis
REDIS_PASSWORD=a_strong_redis_password_here
REDIS_PORT=6379

# MinIO
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=a_strong_minio_password_here
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Agent 预留参数，未使用
AGENT_TOKEN=a_strong_agent_token_here

# 外部访问 IP（用于生成 Agent 安装命令）
# 留空则后端自动检测（优先公网 IP）；填写则直接使用该值
EXTERNAL_IP=