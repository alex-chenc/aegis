# .env - 环境变量配置文件（请勿提交到 Git）

# 数据库
DB_PASSWORD=a_strong_db_password_here
DB_PORT=5432

# Redis
REDIS_PASSWORD=a_strong_redis_password_here
REDIS_PORT=6379

# MinIO
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=a_strong_minio_password_here
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Agent 预留参数，未使用
AGENT_TOKEN=a_strong_agent_token_here

# V6.2 Agent Guard 灰度开关（发布默认全部关闭）
AGENT_GUARD_ENABLED=false
AGENT_GUARD_POLICY_WRITE_ENABLED=false
AGENT_GUARD_ANALYSIS_ENABLED=false
AGENT_GUARD_ACTION_ENABLED=false
AGENT_GUARD_TOOL_ADAPTER_ENABLED=false
AGENT_GUARD_DENY_ENABLED=false
AGENT_GUARD_FREEZE_ENABLED=false
AGENT_GUARD_ACTION_PUBLISH_ENABLED=false
AGENT_GUARD_ACTION_CONSUMER_ENABLED=false
# 启用 Agent Guard 前必须配置长期稳定的随机签名密钥；模板不提供默认密钥。
AGENT_GUARD_SCOPE_SIGNING_KEY=
AGENT_GUARD_PROJECTION_ENABLED=false
AGENT_BEHAVIOR_RULES_ENABLED=false
AGENT_BEHAVIOR_FINDINGS_ENABLED=false
AGENT_BEHAVIOR_ANALYSIS_REQUEST_ENABLED=false
AGENT_GUARD_ALERT_ENABLED=false

# 外部访问 IP（用于生成 Agent 安装命令）
# 留空则后端自动检测（优先公网 IP）；填写则直接使用该值
EXTERNAL_IP=
