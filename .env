# PostgreSQL 配置
POSTGRES_USER=baseline_admin
POSTGRES_PASSWORD=a_very_strong_and_secret_password
POSTGRES_DB=baseline_system

# Redis 配置
REDIS_PASSWORD=another_strong_secret_password

# MinIO 配置
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=a_third_strong_secret_password

# 后端服务配置
BACKEND_GRPC_PORT=9090
BACKEND_HTTP_PORT=8080
# 用于 Agent 身份验证的共享密钥
AGENT_AUTH_TOKEN=a_shared_secret_token_for_agents
# 阿里云百炼大模型 API Key
LLM_API_KEY=**************

# 外部访问 IP/域名 (用于生成 Agent 安装命令)
SERVER_PUBLIC_IP=192.168.152.128
