# PostgreSQL 配置
DB_PASSWORD=a_very_strong_and_secret_password
DB_PORT=5432

# Redis 配置
REDIS_PASSWORD=another_strong_secret_password
REDIS_PORT=6379

# MinIO 配置
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=a_third_strong_secret_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Agent 预留参数
AGENT_TOKEN=a_shared_secret_token_for_agents

# 外部访问 IP（用于生成 Agent 安装命令）
SERVER_PUBLIC_IP=127.0.0.1